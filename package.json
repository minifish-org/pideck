{
  "name": "pideck",
  "version": "0.1.5",
  "description": "A desktop workspace for coding with Pi Durable.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run prepare:automation && npm run build && electron .",
    "prepare:automation": "node scripts/package-assets.mjs",
    "build": "node scripts/build.mjs && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "package": "npm run build && node scripts/package.mjs",
    "verify:frontend": "npm run prepare:automation && npm run build && tsx scripts/verify-frontend.ts",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:reliability": "node scripts/smoke-reliability.mjs",
    "smoke:credentials": "node scripts/smoke-credentials.mjs",
    "check:licenses": "node scripts/licenses.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "prepare:update": "node scripts/update-assets.mjs",
    "sign:update": "node scripts/sign-update.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "diff": "8.0.4",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@pierre/diffs": "1.6.4",
    "@playwright/cli": "0.1.23",
    "@primer/primitives": "11.10.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.0",
    "lucide-react": "1.70.0",
    "playwright": "1.65.0-alpha-2026-10-30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tar": "7.5.22",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "@electron/asar": "3.4.1",
    "semver": "7.8.6"
  },
  "build": {
    "appId": "works.pideck.desktop",
    "productName": "Pideck",
    "directories": {
      "output": "release"
    },
    "beforePack": "scripts/package-assets.mjs",
    "afterPack": "scripts/publish-assets.mjs",
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "node_modules/@primer/primitives/LICENSE",
        "to": "licenses/primer-primitives.txt"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**/*",
      "dist/automation/cli.cjs"
    ],
    "mac": {
      "icon": "build/pideck.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "14.0",
      "extendInfo": {
        "SUFeedURL": "https://github.com/minifish-org/pideck/releases/latest/download/appcast.xml",
        "SUVerifyUpdateBeforeExtraction": true,
        "SURequireSignedFeed": true,
        "SUSignedFeedFailureExpirationInterval": 0,
        "SUEnableAutomaticChecks": true,
        "SUAllowsAutomaticUpdates": false,
        "SUEnableSystemProfiling": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Project Folder",
            "LSItemContentTypes": [
              "public.folder"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "publish": null
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  }
}
